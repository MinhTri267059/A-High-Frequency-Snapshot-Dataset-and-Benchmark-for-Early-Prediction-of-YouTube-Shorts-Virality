  "title": "\u0627\u0644\u0644\u064a\u0644\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 | \u0644\u064a\u0627\u0644\u064a \u0627\u0644\u0627\u0645\u062a\u062d\u0627\u0646 \u0627\u0644\u0623\u062e\u064a\u0631\u0629| \u062b\u0627\u0644\u062b\u0629 \u062b\u0627\u0646\u0648\u064a \u0662\u0660\u0662\u0665 \u0645\u0639 \u0623. \u0645\u062d\u0645\u062f \u0635\u0644\u0627\u062d",
  "description": "#\u062b\u0627\u0644\u062b\u0629_\u062b\u0627\u0646\u0648\u064a\u200b #\u0645\u0631\u0627\u062c\u0639\u0629_\u0646\u0647\u0627\u0626\u064a\u0629\u200b #\u062e\u0644\u0627\u0635\u0629_\u0627\u0644\u062e\u0644\u0627\u0648\u064a\u0635\u200b\n#\u062b\u0627\u0644\u062b\u0629_\u062b\u0627\u0646\u0648\u064a\u200b #\u0645\u0631\u0627\u062c\u0639\u0629_\u0646\u0647\u0627\u0626\u064a\u0629\u200b #\u062e\u0644\u0627\u0635\u0629_\u0627\u0644\u062e\u0644\u0627\u0648\u064a\u0635\u200b\n#\u062b\u0627\u0644\u062b\u0629_\u062b\u0627\u0646\u0648\u064a\u200b #\u062e\u0644\u0627\u0635\u0629_\u0627\u0644\u062e\u0644\u0627\u0648\u064a\u0635\u200b #\u0645\u0631\u0627\u062c\u0639\u0629_\u0646\u0647\u0627\u0626\u064a\u0629\u200b\n#\u062b\u0627\u0644\u062b\u0629_\u062b\u0627\u0646\u0648\u064a\u200b #\u062e\u0644\u0627\u0635\u0629_\u0627\u0644\u062e\u0644\u0627\u0648\u064a\u0635\u200b #\u0645\u0631\u0627\u062c\u0639\u0629_\u0646\u0647\u0627\u0626\u064a\u0629\u200b\n#\u062b\u0627\u0644\u062b\u0629_\u062b\u0627\u0646\u0648\u064a\u200b #\u062e\u0644\u0627\u0635\u0629_\u0627\u0644\u062e\u0644\u0627\u0648\u064a\u0635\u200b #\u0645\u0631\u0627\u062c\u0639\u0629_\u0646\u0647\u0627\u0626\u064a\u0629\u200b\n#\u062b\u0627\u0644\u062b\u0629_\u062b\u0627\u0646\u0648\u064a\u200b #\u062e\u0644\u0627\u0635\u0629_\u0627\u0644\u062e\u0644\u0627\u0648\u064a\u0635\u200b #\u0645\u0631\u0627\u062c\u0639\u0629_\u0646\u0647\u0627\u0626\u064a\u0629\u200b\n#\u062b\u0627\u0644\u062b\u0629_\u062b\u0627\u0646\u0648\u064a\u200b #\u062e\u0644\u0627\u0635\u0629_\u0627\u0644\u062e\u0644\u0627\u0648\u064a\u0635\u200b #\u0645\u0631\u0627\u062c\u0639\u0629_\u0646\u0647\u0627\u0626\u064a\u0629\u200b\n\u0627\u0644\u0644\u064a\u0644\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 | \u0644\u064a\u0627\u0644\u064a \u0627\u0644\u0627\u0645\u062a\u062d\u0627\u0646 \u0627\u0644\u0623\u062e\u064a\u0631\u0629| \u062b\u0627\u0644\u062b\u0629 \u062b\u0627\u0646\u0648\u064a \u0662\u0660\u0662\u0665 \u0645\u0639 \u0623. \u0645\u062d\u0645\u062f \u0635\u0644\u0627\u062d\n\u0645\u0631\u0627\u062c\u0639\u0629 \u0623\u0628\u0631\u064a\u0644\n\u0627\u0648\u0644\u064a \u062b\u0627\u0646\u0648\u064a\n\u0639\u0631\u0628\u064a \u0627\u0648\u0644\u0649 \u062b\u0627\u0646\u0648\u064a\n\u0639\u0631\u0628\u064a \u0623\u0648\u0644\u0649 \u062b\u0627\u0646\u0648\u064a\n\u0627\u0648\u0644\u0649 \u062b\u0627\u0646\u0648\u064a \u0645\u062d\u0645\u062f \u0635\u0644\u0627\u062d\n\u0639\u0631\u0628\u064a \u0627\u0648\u0644\u064a \u062b\u0627\u0646\u0648\u064a \u0627\u0644\u062a\u0631\u0645 \u0627\u0644\u062b\u0627\u0646\u064a\n\u0645\u0631\u0627\u062c\u0639\u0629 \u0639\u0631\u0628\u064a \u062a\u0627\u0644\u062a\u0629 \n\u0645\u0631\u0627\u062c\u0639\u0629 \u0639\u0631\u0628\u064a \u062a\u0627\u0644\u062a\u0629 \u062b\u0627\u0646\u0648\u064a\n\u0645\u0631\u0627\u062c\u0639\u0647 \u0639\u0631\u0628\u064a \u062a\u0627\u0644\u062a\u0647 \u062b\u0627\u0646\u0648\u064a 2024 \n\u0645\u0631\u0627\u062c\u0639\u0647 \u0639\u0631\u0628\u064a \u062a\u0627\u0644\u062a\u0647 \u062b\u0627\u0646\u0648\u064a 2024 \u0645\u062d\u0645\u062f \u0635\u0644\u0627\u062d\n\u0645\u0631\u0627\u062c\u0639\u0647 \u0639\u0631\u0628\u064a \u062a\u0627\u0644\u062a\u0647 \u062b\u0627\u0646\u0648\u064a 2024 \u0644\u064a\u0644\u0647 \u0627\u0644\u0627\u0645\u062a\u062d\u0627\u0646\n\u0645\u0631\u0627\u062c\u0639\u0647 \u0644\u063a\u0647 \u0639\u0631\u0628\u064a\u0647 \u062a\u0627\u0644\u062a\u0647 \u062b\u0627\u0646\u0648\u064a 2024\n\u0645\u0631\u0627\u062c\u0639\u0647 \u0639\u0631\u0628\u064a \u062a\u0627\u0644\u062a\u0647 \u062b\u0627\u0646\u0648\u064a 2024 \u0646\u062d\u0648\n\u0645\u0631\u0627\u062c\u0639\u0647 \u0639\u0631\u0628\u064a \u062a\u0627\u0644\u062a\u0647 \u062b\u0627\u0646\u0648\u064a 2024 \u0628\u0644\u0627\u063a\u0647\n\u062a\u0639\u0628\u064a\u0631 \u0646\u062d\u0648 \u0623\u062f\u0628 \u0628\u0644\u0627\u063a\u0629 \u0642\u0635\u0629 \u0642\u0631\u0627\u0621\u0629\n\u0642\u0631\u0627\u0621\u0629 \u0645\u062a\u062d\u0631\u0631\u0629\n\u0646\u0635\u0648\u0635\n\u0646\u0635\u0648\u0635 \u0645\u062a\u062d\u0631\u0631\u0629\n\u0627\u0645\u062a\u062d\u0627\u0646\u0627\u062a \u0634\u0627\u0645\u0644\u0629\n\u062d\u0644 \u0627\u062e\u062a\u0628\u0627\u0631\u0627\u062a\n\u062d\u0644 \u0627\u0645\u062a\u062d\u0627\u0646\u0627\u062a \u0634\u0627\u0645\u0644\u0629\n\u0627\u0645\u062a\u062d\u0627\u0646\u0627\u062a \u0639\u0631\u0628\u064a\n\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629\n\u0627\u0644\u0635\u0641 \u0627\u0644\u062b\u0627\u0644\u062b \u0627\u0644\u062b\u0627\u0646\u0648\u064a\n\u0645\u0631\u0627\u062c\u0639\u0627\u062a \u0644\u063a\u0629 \u0639\u0631\u0628\u064a\u0629\n\u0644\u064a\u0644\u0629 \u0627\u0644\u0627\u0645\u062a\u062d\u0627\u0646\n\u0627\u0644\u062a\u0639\u0628\u064a\u0631 \u0644\u0644\u0635\u0641 \u0627\u0644\u062b\u0627\u0644\u062b \u0627\u0644\u062b\u0627\u0646\u0648\u064a\n\u0627\u0644\u0646\u062d\u0648 \u0627\u0644\u0635\u0641 \u0627\u0644\u062b\u0627\u0644\u062b \u0627\u0644\u062b\u0627\u0646\u0648\u064a\n\u0627\u0644\u0628\u0644\u0627\u063a\u0629 \u0627\u0644\u0635\u0641 \u0627\u0644\u062b\u0627\u0644\u062b \u0627\u0644\u062b\u0627\u0646\u0648\u064a\n\u0627\u0644\u062a\u0639\u0628\u064a\u0631 \u0627\u0644\u0645\u0642\u0627\u0644\u064a\n\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629\n\u0627\u0644\u0635\u0641 \u0627\u0644\u062b\u0627\u0644\u062b \u0627\u0644\u062b\u0627\u0646\u0648\u064a\n\u0645\u0631\u0627\u062c\u0639\u0627\u062a \u0644\u063a\u0629 \u0639\u0631\u0628\u064a\u0629\n\u062b\u0627\u0646\u0648\u064a\u0629 \u0639\u0627\u0645\u0629\n\u0639\u0631\u0628\u064a\n \u062b\u0627\u0646\u0648\u064a\u0629\n\u0627\u0644\u062a\u0639\u0628\u064a\u0631\n\u0623\u0646\u0645\u0627\u0637 \u0627\u0644\u062a\u0639\u0628\u064a\u0631 \u0627\u0644\u062c\u062f\u064a\u062f\u0629\n\u0627\u0644\u0645\u0648\u0636\u0648\u0639\n\u0627\u0644\u0645\u0642\u0627\u0644\n\u0627\u0644\u0643\u0644\u0645\u0629 \u0627\u0644\u0627\u0641\u062a\u