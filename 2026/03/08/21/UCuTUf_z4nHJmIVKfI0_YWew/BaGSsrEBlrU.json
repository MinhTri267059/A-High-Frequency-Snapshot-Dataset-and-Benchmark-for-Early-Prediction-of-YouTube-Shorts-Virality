  "title": "\u0905\u0902\u0924\u0930\u0930\u093e\u0937\u094d\u091f\u094d\u0930\u0940\u092f \u092e\u0939\u093f\u0932\u093e \u0926\u093f\u0935\u0938| Int. Women's day 2026\ud83c\udf39#women #internationalwomensday #8march #2026 #shorts",
  "description": "International Women's Day \u0939\u0930 \u0938\u093e\u0932 8 \u092e\u093e\u0930\u094d\u091a \u0915\u094b \u092e\u0928\u093e\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u092f\u0939 \u0926\u093f\u0928 \u092e\u0939\u093f\u0932\u093e\u0913\u0902 \u0915\u0940 \u0909\u092a\u0932\u092c\u094d\u0927\u093f\u092f\u094b\u0902, \u0905\u0927\u093f\u0915\u093e\u0930\u094b\u0902 \u0914\u0930 \u0938\u092e\u093e\u091c \u092e\u0947\u0902 \u0909\u0928\u0915\u0947 \u092f\u094b\u0917\u0926\u093e\u0928 \u0915\u094b \u0938\u092e\u094d\u092e\u093e\u0928 \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u0939\u0948\u0964 \ud83c\udf38\u2728\n\u092e\u0939\u093f\u0932\u093e\u0913\u0902 \u0926\u093f\u0935\u0938 \u0915\u093e \u0938\u0902\u0915\u094d\u0937\u093f\u092a\u094d\u0924 \u0935\u093f\u0935\u0930\u0923\n\u092e\u0939\u093f\u0932\u093e\u0913\u0902 \u0926\u093f\u0935\u0938 \u0915\u093e \u0938\u0902\u0915\u094d\u0937\u093f\u092a\u094d\u0924 \u0935\u093f\u0935\u0930\u0923\n\n\u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f: \u092e\u0939\u093f\u0932\u093e\u0913\u0902 \u0915\u0947 \u0905\u0927\u093f\u0915\u093e\u0930\u094b\u0902, \u0938\u092e\u093e\u0928\u0924\u093e \u0914\u0930 \u0938\u0936\u0915\u094d\u0924\u093f\u0915\u0930\u0923 \u0915\u094b \u092c\u0922\u093c\u093e\u0935\u093e \u0926\u0947\u0928\u093e\u0964\n\n\u0907\u0924\u093f\u0939\u093e\u0938: \u0907\u0938\u0915\u0940 \u0936\u0941\u0930\u0941\u0906\u0924 20\u0935\u0940\u0902 \u0938\u0926\u0940 \u0915\u0940 \u0936\u0941\u0930\u0941\u0906\u0924 \u092e\u0947\u0902 \u092e\u0939\u093f\u0932\u093e\u0913\u0902 \u0915\u0947 \u0936\u094d\u0930\u092e \u0905\u0927\u093f\u0915\u093e\u0930 \u0914\u0930 \u0935\u094b\u091f \u0926\u0947\u0928\u0947 \u0915\u0947 \u0905\u0927\u093f\u0915\u093e\u0930 \u0915\u0940 \u092e\u093e\u0902\u0917 \u0938\u0947 \u0939\u0941\u0908 \u0925\u0940\u0964 \u092c\u093e\u0926 \u092e\u0947\u0902 United Nations \u0928\u0947 1975 \u092e\u0947\u0902 \u0907\u0938\u0947 \u0906\u0927\u093f\u0915\u093e\u0930\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u092e\u0928\u093e\u0928\u093e \u0936\u0941\u0930\u0942 \u0915\u093f\u092f\u093e\u0964\n\n\u092e\u0939\u0924\u094d\u0935: \u092f\u0939 \u0926\u093f\u0928 \u0939\u092e\u0947\u0902 \u092f\u093e\u0926 \u0926\u093f\u0932\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u0938\u092e\u093e\u091c, \u0936\u093f\u0915\u094d\u0937\u093e, \u0930\u093e\u091c\u0928\u0940\u0924\u093f, \u0935\u093f\u091c\u094d\u091e\u093e\u0928, \u0914\u0930 \u0939\u0930 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u092e\u0939\u093f\u0932\u093e\u0913\u0902 \u0915\u093e \u092f\u094b\u0917\u0926\u093e\u0928 \u092c\u0939\u0941\u0924 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0939\u0948\u0964\n\n\n\n\u0907\u0938 \u0926\u093f\u0928 \u0915\u094d\u092f\u093e \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948?\n\n\u092e\u0939\u093f\u0932\u093e\u0913\u0902 \u0915\u094b \u0938\u092e\u094d\u092e\u093e\u0928\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \ud83c\udfc6\n\n\u091c\u093e\u0917\u0930\u0942\u0915\u0924\u093e \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e \u0914\u0930 \u0938\u0947\u092e\u093f\u0928\u093e\u0930 \u0906\u092f\u094b\u091c\u093f\u0924 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902 \ud83c\udfa4\n\n\u0938\u094b\u0936\u0932 \u092e\u0940\u0921\u093f\u092f\u093e \u092a\u0930 \u092e\u0939\u093f\u0932\u093e\u0913\u0902 \u0915\u0940 \u092a\u094d\u0930\u0947\u0930\u0923\u093e\u0926\u093e\u092f\u0915 \u0915\u0939\u093e\u0928\u093f\u092f\u093e\u0901 \u0938\u093e\u091d\u093e \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0902 \ud83d\udcf1\n\n\u0915\u0908 \u091c\u0917\u0939\u094b\u0902 \u092a\u0930 \u0930\u0948\u0932\u093f\u092f\u093e\u0901 \u0914\u0930 \u0905\u092d\u093f\u092f\u093e\u0928 \u091a\u0932\u093e\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\n\n\u0938\u0902\u0926\u0947\u0936\n\n\u092e\u0939\u093f\u0932\u09